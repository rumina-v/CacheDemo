# ==========================================
# .NET / C# .gitignore
# ==========================================

# Build output
[Bb]in/
[Oo]bj/
[Dd]ebug/
[Rr]elease/
x64/
x86/
arm64/
[Aa]rtifacts/

# Visual Studio
.vs/
*.user
*.userosscache
*.suo
*.sln.docstates
*.VC.db
*.VC.VC.opendb

# Visual Studio Code
.vscode/
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# JetBrains Rider / ReSharper
.idea/
*.DotSettings.user
_ReSharper*/
*.[Rr]e[Ss]harper
*.ncrunch*
*.resharper.user

# NuGet
packages/
*.nupkg
*.snupkg
.nuget/
NuGet.Config.local

# .NET generated files
project.lock.json
project.fragment.lock.json
artifacts/
GeneratedFiles/
obj/
*.deps.json
*.runtimeconfig.json

# Test results
TestResults/
[Tt]est[Rr]esult*/
*.trx
*.testlog

# Code coverage
coverage/
*.coverage
*.coveragexml
*.opencover.xml
*.lcov

# Logs
*.log
logs/

# Temporary files
*.tmp
*.temp
*.bak
*.swp
*.swo
*~

# ==========================================
# Executables and binaries
# ==========================================

# Windows executables
*.exe
*.com
*.msi
*.msp
*.appx
*.appxbundle

# Dynamic libraries
*.dll
*.so
*.dylib

# Static libraries
*.lib
*.a

# Object files
*.obj
*.o

# Binary data
*.bin
*.dat
*.pdb
*.ilk
*.exp

# Debug / profiling
*.dmp
*.prof
*.vsix

# Native build files
*.idb
*.ipdb
*.iobj
*.tlog

# ==========================================
# Archives
# ==========================================

*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz

# ==========================================
# Database / local development files
# ==========================================

*.db
*.sqlite
*.sqlite3
*.mdf
*.ldf

# ==========================================
# Local configuration / secrets
# ==========================================

.env
.env.*
!.env.example
*.local.json
appsettings.Local.json
appsettings.Development.json
appsettings.Production.json

# User-specific ASP.NET files
launchSettings.json

# ==========================================
# Entity Framework
# ==========================================

*.migration.cs
Migrations/*.Designer.cs

# ==========================================
# Windows
# ==========================================

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# ==========================================
# macOS
# ==========================================

.DS_Store
.AppleDouble
.LSOverride
._*

# ==========================================
# Linux
# ==========================================

*~
.directory
.Trash-*

# ==========================================
# Docker
# ==========================================

docker-compose.override.yml
.docker/

# ==========================================
# Publish output
# ==========================================

publish/
[Pp]ublish/
*.publishsettings

# ==========================================
# Azure / local tooling
# ==========================================

.azure/
.azure-pipelines/
*.publishproj

# ==========================================
# Rider / Mono / Xamarin
# ==========================================

mono_crash.*
*.userprefs
*.pidb
*.svd

# ==========================================
# Generated documentation
# ==========================================

*.xml
!Directory.Build.targets.xml

# ==========================================
# Certificates / keys
# ==========================================

*.pfx
*.p12
*.key
*.pem
*.cer

# ==========================================
# Node.js files if frontend is inside .NET project
# ==========================================

node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# ==========================================
# Frontend build output
# ==========================================

wwwroot/dist/
wwwroot/build/
wwwroot/node_modules/

# ==========================================
# Miscellaneous generated files
# ==========================================

*.cache
*.pid
*.pidb
*.seed
*.stackdump
*.bak
*.orig

# Local folders
/local/
/temp/
/tmp/
